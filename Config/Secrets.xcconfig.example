// Gemini API key — copy this file to Secrets.xcconfig and paste your key after the equals sign.
// Get a key at https://aistudio.google.com/apikey (free tier is fine for development).
//
// Rules:
//   • No quotes around the key.
//   • No spaces inside the key itself.
//   • Secrets.xcconfig is git-ignored and must never be committed.
//
// Without a key the app builds and runs normally; Dash just answers on-device instead of
// calling Gemini. You only need this if you want to test the Gemini Live API path.

GEMINI_API_KEY = your-key-here
